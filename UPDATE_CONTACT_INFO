intent_id: INT_003
intent_name: UPDATE_CONTACT_INFO
description: User wants to update their contact information
intent_group: Customer Profile
priority: medium

slots:
  - slot_name: contact_type
    entity_type: CONTACT_TYPE
    is_required: true
    prompt_question: "What would you like to update? (email, phone, address)"
    
  - slot_name: new_value
    entity_type: STRING
    is_required: true
    prompt_question: "What is your new {contact_type}?"
    validation_rules: dependent_on_contact_type

domain_mapping:
  - data_product: Customer Profile Service
  - data_product: Verification Service
