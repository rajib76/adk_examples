CREATE TABLE reference_db.public.transaction_categories (
    merchant_category_code VARCHAR(10) PRIMARY KEY,
    category_name VARCHAR(100) NOT NULL,
    category_group VARCHAR(50) NOT NULL,
    category_description TEXT,
    icon_name VARCHAR(50),
    color_code VARCHAR(7),
    is_discretionary BOOLEAN DEFAULT TRUE,
    parent_category_code VARCHAR(10),
    sort_order INTEGER,
    
    CONSTRAINT fk_parent_category
        FOREIGN KEY (parent_category_code)
        REFERENCES reference_db.public.transaction_categories(merchant_category_code)
);

