CREATE TABLE core_banking_db.reference.account_types (
    account_type_code VARCHAR(10) PRIMARY KEY,
    account_type_name VARCHAR(50) NOT NULL,
    account_category VARCHAR(30) NOT NULL,
    description TEXT,
    is_active BOOLEAN DEFAULT TRUE,
    allows_overdraft BOOLEAN DEFAULT FALSE,
    interest_bearing BOOLEAN DEFAULT FALSE,
    minimum_balance DECIMAL(18,2) DEFAULT 0.00,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    
    CONSTRAINT chk_category
        CHECK (account_category IN ('deposit_account', 'credit_account', 'investment_account', 'loan_account'))
);

